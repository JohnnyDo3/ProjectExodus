// Project Exodus - Comprehensive Database Schema
// Full-featured sustainability hub platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For email/password auth

  // LinkedIn-style Profile Fields
  bio           String?   @db.Text
  headline      String?   // Professional tagline (e.g., "Sustainability Advocate | Green Building Expert")
  banner        String?   // Banner/cover image URL
  location      String?
  phone         String?   // Contact phone number
  company       String?   // Current company/organization
  jobTitle      String?   // Current job title
  website       String?   // Personal website or portfolio
  linkedin      String?   // LinkedIn profile URL
  twitter       String?   // Twitter/X handle
  interests     String[]  // Array of interests
  expertise     String[]  // Array of skills/expertise areas

  // Professional Background
  experience    Json?     // Array of work experience objects
  education     Json?     // Array of education objects
  resume        String?   // Uploaded resume/CV file path or URL

  // LinkedIn-style Additional Sections
  skills        Json?     // Array of skill objects {name, level}
  languages     Json?     // Array of language objects {name, proficiency}
  certifications Json?    // Array of certification objects {name, issuer, date, url}
  volunteer     Json?     // Array of volunteer experience objects {role, organization, startDate, endDate, description}
  publications  Json?     // Array of publication objects {title, publisher, date, url, description}
  honors        Json?     // Array of honors/awards objects {title, issuer, date, description}
  projects      Json?     // Array of project objects {name, startDate, endDate, description, url}

  // Identity Declaration (7 Guardians)
  guardianArchetype String?   // Selected guardian value: michael, gabriel, raphael, uriel, camael, jophiel, zadkiel
  declaration       String?   @db.Text // Personal declaration/truth statement

  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  reviews               Review[]
  articles              Article[]
  comments              Comment[]
  savedProducts         SavedProduct[]
  savedArticles         SavedArticle[]
  notifications         Notification[]
  adminLogs             AdminLog[]
  following             UserFollow[]       @relation("Following")
  followers             UserFollow[]       @relation("Followers")
  userBadges            UserBadge[]
  projectMemberships    ProjectMember[]
  createdProjects       Project[]          @relation("ProjectCreator")
  projectMessages       ProjectMessage[]   @relation("ProjectMessages")
  sentMessages          DirectMessage[]    @relation("SentMessages")
  receivedMessages      DirectMessage[]    @relation("ReceivedMessages")
  createdEvents         Event[]            @relation("CreatedEvents")
  eventAttendances      EventAttendee[]
  reportedContent       Report[]
  socialPosts           SocialPost[]     @relation("SocialPosts")
  socialComments        SocialComment[]  @relation("SocialComments")
  socialLikes           SocialLike[]     @relation("SocialLikes")
  userProducts          UserProduct[]    @relation("UserProducts")
  sentConnections       Connection[]     @relation("SentConnections")
  receivedConnections   Connection[]     @relation("ReceivedConnections")
  learningProgress      UserLearningProgress[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  USER
  EDITOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// PRODUCT MODELS
// ============================================

model Product {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  description           String    @db.Text
  specifications        Json?     // Flexible product specs
  price                 Decimal?  @db.Decimal(10, 2)
  purchaseLink          String?
  status                ProductStatus @default(PENDING)
  featured              Boolean   @default(false)
  viewCount             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  publishedAt           DateTime?

  // Relations
  categoryId            String
  category              Category  @relation(fields: [categoryId], references: [id])
  vendorId              String?
  vendor                Vendor?   @relation(fields: [vendorId], references: [id])
  images                ProductImage[]
  tags                  ProductTag[]
  sustainabilityMetric  SustainabilityMetric?
  reviews               Review[]
  savedBy               SavedProduct[]
  certifications        ProductCertification[]

  @@index([slug])
  @@index([categoryId])
  @@index([vendorId])
  @@index([status])
  @@index([featured])
}

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Vendor {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  website     String?
  logo        String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  products  ProductTag[]
  articles  ArticleTag[]
  createdAt DateTime     @default(now())

  @@index([slug])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model SustainabilityMetric {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Carbon metrics
  carbonFootprint       Decimal? @db.Decimal(10, 2) // kg CO2e
  carbonSavings         Decimal? @db.Decimal(10, 2) // vs conventional

  // Water metrics
  waterUsage            Decimal? @db.Decimal(10, 2) // liters
  waterSavings          Decimal? @db.Decimal(10, 2)

  // Material metrics
  recycledContent       Int?     // percentage
  recyclable            Boolean  @default(false)
  biodegradable         Boolean  @default(false)

  // Energy metrics
  energyEfficiencyRating String? // A+, A, B, etc.
  renewableEnergy       Boolean  @default(false)

  // Lifecycle
  lifespanYears         Int?
  repairability         Int?     // score 1-10

  // Overall score (calculated)
  sustainabilityScore   Int?     // 0-100

  // Additional data
  materialsBreakdown    Json?    // Flexible structure
  certificationData     Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Certification {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?                @db.Text
  logo        String?
  website     String?
  products    ProductCertification[]
  createdAt   DateTime               @default(now())

  @@index([slug])
}

model ProductCertification {
  productId       String
  certificationId String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  verifiedAt      DateTime?
  expiresAt       DateTime?

  @@id([productId, certificationId])
  @@index([productId])
  @@index([certificationId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  title     String?
  content   String   @db.Text
  verified  Boolean  @default(false) // Verified purchase
  helpful   Int      @default(0)
  productId String
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================
// EDUCATIONAL CONTENT MODELS
// ============================================

model Article {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  excerpt         String?          @db.Text
  content         String           @db.Text
  coverImage      String?
  readTime        Int?             // minutes
  views           Int              @default(0)
  status          ArticleStatus    @default(DRAFT)
  featured        Boolean          @default(false)
  authorId        String
  author          User             @relation(fields: [authorId], references: [id])
  categoryId      String
  category        ArticleCategory  @relation(fields: [categoryId], references: [id])
  tags            ArticleTag[]
  comments        Comment[]
  savedBy         SavedArticle[]
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?

  // Learning Module Fields
  moduleType      ModuleType?      // SMALL (quick facts) or LARGE (tabs + quiz)
  moduleTabs      Json?            // Array of tab objects: [{title: string, content: string}]
  quizQuestions   Json?            // Array of quiz objects: [{question: string, type: 'multiple_choice'|'true_false', options: string[], correctAnswer: string}]
  estimatedTime   Int?             // Estimated minutes to complete
  difficulty      String?          // 'Beginner', 'Intermediate', 'Advanced'
  learningProgress UserLearningProgress[]

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([moduleType])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  articleId String
  userId    String
  parentId  String?  // For nested comments
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

enum ModuleType {
  SMALL   // Quick facts, mark as read
  LARGE   // Tabs + quiz with perfect score requirement
}

// Learning Progress Tracking
model UserLearningProgress {
  id                String         @id @default(cuid())
  userId            String
  articleId         String

  // Progress tracking
  status            LearningStatus @default(IN_PROGRESS)
  progressPercentage Int           @default(0)  // 0-100 for large modules
  currentTabIndex   Int            @default(0)  // Current tab user is on (for large modules)

  // Quiz tracking (for large modules)
  quizAttempts      Int            @default(0)
  quizScore         Int?           // Last quiz score (0-5)
  quizPassed        Boolean        @default(false) // Must achieve perfect score (5/5)

  // Timestamps
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
  lastAccessedAt    DateTime       @updatedAt

  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  article           Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([status])
}

enum LearningStatus {
  IN_PROGRESS
  COMPLETED
}

// ============================================
// SOCIAL & GAMIFICATION MODELS
// ============================================

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// LinkedIn-style Connection model (mutual professional connections)
model Connection {
  id              String            @id @default(cuid())
  userId          String            // User who sent the request
  connectedUserId String            // User who received the request
  status          ConnectionStatus  @default(PENDING)
  message         String?           @db.Text // Optional message with connection request
  createdAt       DateTime          @default(now())
  acceptedAt      DateTime?         // When connection was accepted
  updatedAt       DateTime          @updatedAt

  user            User              @relation("SentConnections", fields: [userId], references: [id], onDelete: Cascade)
  connectedUser   User              @relation("ReceivedConnections", fields: [connectedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, connectedUserId])
  @@index([userId])
  @@index([connectedUserId])
  @@index([status])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// LinkedIn-style Skill Endorsement model
model Endorsement {
  id          String   @id @default(cuid())
  userId      String   // User being endorsed
  endorserId  String   // User giving the endorsement
  skill       String   // Skill being endorsed
  createdAt   DateTime @default(now())

  @@unique([userId, endorserId, skill])
  @@index([userId])
  @@index([endorserId])
  @@index([skill])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String      @db.Text
  icon        String
  criteria    Json        // Flexible criteria definition
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())

  @@index([slug])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ============================================
// SOCIAL FEED MODELS (Instagram/Meta-style)
// ============================================

model SocialPost {
  id          String          @id @default(cuid())
  content     String          @db.Text
  userId      String
  visibility  PostVisibility  @default(PUBLIC)
  user        User            @relation("SocialPosts", fields: [userId], references: [id], onDelete: Cascade)
  media       SocialMedia[]
  comments    SocialComment[]
  likes       SocialLike[]
  hashtags    String[]        // Array of hashtags
  mentions    String[]        // Array of mentioned user IDs
  shares      Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([visibility])
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

model SocialMedia {
  id        String    @id @default(cuid())
  postId    String
  type      MediaType
  url       String
  caption   String?
  order     Int       @default(0)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([postId])
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
}

model SocialComment {
  id        String          @id @default(cuid())
  content   String          @db.Text
  postId    String
  userId    String
  parentId  String?         // For nested comments
  post      SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User            @relation("SocialComments", fields: [userId], references: [id], onDelete: Cascade)
  parent    SocialComment?  @relation("CommentThread", fields: [parentId], references: [id])
  children  SocialComment[] @relation("CommentThread")
  likes     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation("SocialLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ============================================
// PROJECT COLLABORATION MODELS
// ============================================

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String          @db.Text
  goal        String?         @db.Text
  status      ProjectStatus   @default(ACTIVE)
  coverImage  String?
  creatorId   String
  creator     User            @relation("ProjectCreator", fields: [creatorId], references: [id])
  members     ProjectMember[]
  messages    ProjectMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([creatorId])
  @@index([status])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole   @default(MEMBER)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime      @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

enum ProjectRole {
  MEMBER
  MODERATOR
  ADMIN
}

model ProjectMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectMessages", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// DIRECT MESSAGING MODELS
// ============================================

model DirectMessage {
  id           String   @id @default(cuid())
  content      String   @db.Text
  senderId     String
  receiverId   String
  read         Boolean  @default(false)
  sender       User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([read])
}

// ============================================
// EVENTS & MEETUPS MODELS
// ============================================

model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  type        EventType     @default(VIRTUAL)
  location    String?       // For in-person events
  meetingLink String?       // For virtual events
  startDate   DateTime
  endDate     DateTime?
  maxCapacity Int?
  coverImage  String?
  creatorId   String
  creator     User          @relation("CreatedEvents", fields: [creatorId], references: [id])
  attendees   EventAttendee[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([creatorId])
  @@index([startDate])
  @@index([type])
}

enum EventType {
  VIRTUAL
  IN_PERSON
  HYBRID
}

model EventAttendee {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  status    AttendeeStatus   @default(GOING)
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime         @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

enum AttendeeStatus {
  GOING
  MAYBE
  NOT_GOING
}

// ============================================
// NOTIFICATION & MODERATION MODELS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  PRODUCT_APPROVED
  ARTICLE_PUBLISHED
  COMMENT_REPLY
  FORUM_REPLY
  NEW_FOLLOWER
  BADGE_EARNED
  PROJECT_INVITE
  SYSTEM
}

model Report {
  id           String       @id @default(cuid())
  reason       String       @db.Text
  status       ReportStatus @default(PENDING)
  reporterId   String
  reporter     User         @relation(fields: [reporterId], references: [id])

  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([reporterId])
  @@index([status])
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model AdminLog {
  id          String         @id @default(cuid())
  action      AdminAction
  description String         @db.Text
  metadata    Json?
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum AdminAction {
  USER_BANNED
  USER_UNBANNED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  ARTICLE_PUBLISHED
  ARTICLE_UNPUBLISHED
  CONTENT_DELETED
  REPORT_RESOLVED
  SETTINGS_CHANGED
  OTHER
}

// ============================================
// USER MARKETPLACE MODELS
// ============================================

model UserProduct {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  price           Float
  category        String
  materials       String   // Sustainable materials used
  images          String[] // Array of image URLs
  externalUrl     String   // Link to user's store (Etsy, Shopify, etc.)

  // Approval workflow
  approvalStatus  ProductApprovalStatus @default(PENDING)
  rejectionReason String?  @db.Text
  affiliateLink   String?  // Project Exodus affiliate link (generated after approval)
  reviewedBy      String?  // Admin who reviewed
  reviewedAt      DateTime?

  // Seller info
  sellerId        String
  seller          User     @relation("UserProducts", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sellerId])
  @@index([approvalStatus])
  @@index([category])
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// SYSTEM & SETTINGS MODELS
// ============================================

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  html      String   @db.Text
  text      String?  @db.Text
  variables Json?    // Available variables
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  status      SubscriptionStatus @default(ACTIVE)
  source      String?  // Where they subscribed from
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}
