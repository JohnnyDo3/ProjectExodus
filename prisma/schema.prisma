// Project Exodus - Comprehensive Database Schema
// Full-featured sustainability hub platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For email/password auth

  // LinkedIn-style Profile Fields
  bio           String?   @db.Text
  headline      String?   // Professional tagline (e.g., "Sustainability Advocate | Green Building Expert")
  banner        String?   // Banner/cover image URL
  location      String?
  phone         String?   // Contact phone number
  showEmail     Boolean   @default(false)
  showPhone     Boolean   @default(false)
  company       String?   // Current company/organization
  jobTitle      String?   // Current job title
  website       String?   // Personal website or portfolio
  linkedin      String?   // LinkedIn profile URL
  twitter       String?   // Twitter/X handle
  interests     String[]  // Array of interests
  expertise     String[]  // Array of skills/expertise areas

  // Professional Background
  experience    Json?     // Array of work experience objects
  education     Json?     // Array of education objects
  resume        String?   // Uploaded resume/CV file path or URL

  // LinkedIn-style Additional Sections
  skills        Json?     // Array of skill objects {name, level}
  languages     Json?     // Array of language objects {name, proficiency}
  certifications Json?    // Array of certification objects {name, issuer, date, url}
  volunteer     Json?     // Array of volunteer experience objects {role, organization, startDate, endDate, description}
  publications  Json?     // Array of publication objects {title, publisher, date, url, description}
  honors        Json?     // Array of honors/awards objects {title, issuer, date, description}
  projects      Json?     // Array of project objects {name, startDate, endDate, description, url}

  // Identity Declaration (7 Guardians)
  guardianArchetype String?   // Selected guardian value: michael, gabriel, raphael, uriel, camael, jophiel, zadkiel
  declaration       String?   @db.Text // Personal declaration/truth statement

  // Privacy Settings (JSON object with all privacy preferences)
  privacySettings   Json?     // { profileVisibility, showExperience, showEducation, showSkills, showBadges, showContact, allowMessages, resumeVisibility }

  // Notification Preferences (JSON object with notification settings)
  notificationPreferences Json? // { email, newsletter, communityUpdates, productUpdates, messages, connectionRequests, endorsements }

  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  reviews               Review[]
  articles              Article[]
  comments              Comment[]
  savedProducts         SavedProduct[]
  savedArticles         SavedArticle[]
  articleReads          ArticleRead[]
  notifications         Notification[]
  adminLogs             AdminLog[]
  following             UserFollow[]       @relation("Following")
  followers             UserFollow[]       @relation("Followers")
  userBadges            UserBadge[]
  projectMemberships    ProjectMember[]
  createdProjects       Project[]          @relation("ProjectCreator")
  projectMessages       ProjectMessage[]   @relation("ProjectMessages")
  sentMessages          DirectMessage[]    @relation("SentMessages")
  receivedMessages      DirectMessage[]    @relation("ReceivedMessages")
  messageReactions      MessageReaction[]  @relation("MessageReactions")
  createdEvents         Event[]            @relation("CreatedEvents")
  eventAttendances      EventAttendee[]
  reportedContent       Report[]           @relation("ReportedBy")
  assignedReports       Report[]           @relation("ReportAssignedTo")
  resolvedReports       Report[]           @relation("ReportResolvedBy")
  socialPosts           SocialPost[]     @relation("SocialPosts")
  socialComments        SocialComment[]  @relation("SocialComments")
  socialLikes           SocialLike[]     @relation("SocialLikes")
  userProducts          UserProduct[]    @relation("UserProducts")
  sentConnections       Connection[]     @relation("SentConnections")
  receivedConnections   Connection[]     @relation("ReceivedConnections")
  learningProgress      UserLearningProgress[]
  articlePeerReviews    ArticlePeerReview[] @relation("ArticlePeerReviews")
  reviewLikes           ReviewLike[]       @relation("ReviewLikes")
  adminAlerts           AdminAlert[]       @relation("AdminAlerts")

  // Multi-level learning system
  moduleDiscussions         ModuleDiscussion[]      @relation("ModuleDiscussionAuthor")
  moduleDiscussionReplies   ModuleDiscussionReply[] @relation("ModuleDiscussionReplyAuthor")
  discussionHelpfulVotes    DiscussionHelpfulVote[] @relation("DiscussionHelpfulVoter")

  // Article reading experience
  readingProgress           ArticleReadingProgress[] @relation("ArticleReadingProgress")
  articleBookmarks          ArticleBookmark[]        @relation("ArticleBookmarks")
  articleHighlights         ArticleHighlight[]       @relation("ArticleHighlights")

  // Reading collections
  readingCollections        ReadingCollection[]      @relation("ReadingCollections")
  collectionFollows         CollectionFollow[]       @relation("CollectionFollows")

  // Gamification
  userAchievements          UserAchievement[]        @relation("UserAchievements")
  readingStreak             ReadingStreak?           @relation("ReadingStreak")
  userPoints                UserPoints?              @relation("UserPoints")

  // Author analytics
  authorAnalytics           AuthorAnalytics?         @relation("AuthorAnalytics")

  // Recommendations
  articleRecommendations    ArticleRecommendation[]  @relation("ArticleRecommendations")

  // Enhanced Project Relations
  subgroupLeaderships       SubgroupLeader[]         @relation("SubgroupLeaders")
  subgroupMemberships       SubgroupMember[]         @relation("SubgroupMembers")
  subgroupJoinRequests      SubgroupJoinRequest[]    @relation("SubgroupJoinRequests")
  projectDiscussions        ProjectDiscussion[]      @relation("ProjectDiscussionAuthor")
  projectDiscussionReplies  ProjectDiscussionReply[] @relation("ProjectDiscussionReplyAuthor")
  subgroupDiscussions       SubgroupDiscussion[]     @relation("SubgroupDiscussionAuthor")
  subgroupDiscussionReplies SubgroupDiscussionReply[] @relation("SubgroupDiscussionReplyAuthor")
  projectResearchPosts      ProjectResearch[]        @relation("ProjectResearchAuthor")
  projectResearchComments   ProjectResearchComment[] @relation("ProjectResearchCommentAuthor")
  projectModuleProgress     ProjectModuleProgress[]  @relation("ProjectModuleProgress")
  projectWaivers            ProjectPrerequisiteWaiver[] @relation("ProjectWaivers")
  projectWaiversApproved    ProjectPrerequisiteWaiver[] @relation("ProjectWaiversApproved")
  projectContributions      ProjectContribution[]    @relation("ProjectContributions")
  projectNotifications      ProjectNotification[]    @relation("ProjectNotifications")

  // Exodology learning progress
  exodologyProgress         ExodologyProgress[]      @relation("ExodologyProgress")
  exodologyCertifications   ExodologyCertification[] @relation("ExodologyCertifications")
  exodologyStreak           ExodologyStreak?         @relation("ExodologyStreak")
  exodologyNotes            ExodologyNote[]          @relation("ExodologyNotes")
  exodologyReviews          ExodologyReview[]        @relation("ExodologyReviews")

  @@index([email])
  @@index([role])
}

enum UserRole {
  USER
  EDITOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// PRODUCT MODELS
// ============================================

model Product {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  description           String    @db.Text
  specifications        Json?     // Flexible product specs
  price                 Decimal?  @db.Decimal(10, 2)
  purchaseLink          String?
  status                ProductStatus @default(PENDING)
  featured              Boolean   @default(false)
  viewCount             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  publishedAt           DateTime?

  // Relations
  categoryId            String
  category              Category  @relation(fields: [categoryId], references: [id])
  vendorId              String?
  vendor                Vendor?   @relation(fields: [vendorId], references: [id])
  images                ProductImage[]
  tags                  ProductTag[]
  sustainabilityMetric  SustainabilityMetric?
  reviews               Review[]
  savedBy               SavedProduct[]
  certifications        ProductCertification[]

  @@index([slug])
  @@index([categoryId])
  @@index([vendorId])
  @@index([status])
  @@index([featured])
}

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Vendor {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  website     String?
  logo        String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  products  ProductTag[]
  articles  ArticleTag[]
  createdAt DateTime     @default(now())

  @@index([slug])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model SustainabilityMetric {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Carbon metrics
  carbonFootprint       Decimal? @db.Decimal(10, 2) // kg CO2e
  carbonSavings         Decimal? @db.Decimal(10, 2) // vs conventional

  // Water metrics
  waterUsage            Decimal? @db.Decimal(10, 2) // liters
  waterSavings          Decimal? @db.Decimal(10, 2)

  // Material metrics
  recycledContent       Int?     // percentage
  recyclable            Boolean  @default(false)
  biodegradable         Boolean  @default(false)

  // Energy metrics
  energyEfficiencyRating String? // A+, A, B, etc.
  renewableEnergy       Boolean  @default(false)

  // Lifecycle
  lifespanYears         Int?
  repairability         Int?     // score 1-10

  // Overall score (calculated)
  sustainabilityScore   Int?     // 0-100

  // Additional data
  materialsBreakdown    Json?    // Flexible structure
  certificationData     Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Certification {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?                @db.Text
  logo        String?
  website     String?
  products    ProductCertification[]
  createdAt   DateTime               @default(now())

  @@index([slug])
}

model ProductCertification {
  productId       String
  certificationId String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  verifiedAt      DateTime?
  expiresAt       DateTime?

  @@id([productId, certificationId])
  @@index([productId])
  @@index([certificationId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  title     String?
  content   String   @db.Text
  verified  Boolean  @default(false) // Verified purchase
  helpful   Int      @default(0)
  productId String
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ============================================
// EDUCATIONAL CONTENT MODELS
// ============================================

model Article {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  excerpt         String?          @db.Text
  content         String           @db.Text
  coverImage      String?
  readTime        Int?             // minutes
  views           Int              @default(0)
  status          ArticleStatus    @default(DRAFT)
  featured        Boolean          @default(false)
  authorId        String
  author          User             @relation(fields: [authorId], references: [id])
  categoryId      String
  category        ArticleCategory  @relation(fields: [categoryId], references: [id])
  tags            ArticleTag[]
  comments        Comment[]
  peerReviews     ArticlePeerReview[]
  savedBy         SavedArticle[]
  readBy          ArticleRead[]
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?

  // Learning Module Fields
  moduleType      ModuleType?      // SMALL (quick facts) or LARGE (tabs + quiz)
  moduleTabs      Json?            // Array of tab objects: [{title: string, content: string}]
  quizQuestions   Json?            // Array of quiz objects: [{question: string, type: 'multiple_choice'|'true_false', options: string[], correctAnswer: string}]
  estimatedTime   Int?             // Estimated minutes to complete
  difficulty      String?          // 'Beginner', 'Intermediate', 'Advanced'
  learningProgress UserLearningProgress[]

  // Multi-level learning system
  levelContents     ModuleLevelContent[]
  moduleDiscussions ModuleDiscussion[]

  // Reading experience relations
  readingProgress     ArticleReadingProgress[] @relation("ArticleReadingProgress")
  bookmarks           ArticleBookmark[]        @relation("ArticleBookmarks")
  highlights          ArticleHighlight[]       @relation("ArticleHighlights")

  // Collections
  inCollections       CollectionArticle[]      @relation("CollectionArticles")

  // Recommendations
  recommendations     ArticleRecommendation[]  @relation("ArticleRecommendations")

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([moduleType])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  articleId String
  userId    String
  parentId  String?  // For nested comments
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

// Article Peer Reviews - Reddit-style threaded reviews with ratings
model ArticlePeerReview {
  id          String   @id @default(cuid())
  articleId   String
  userId      String
  parentId    String?  // For nested replies (unlimited depth)

  // Rating fields (only for top-level reviews, null for replies)
  rating      Int?     // 1-5 overall rating
  accuracy    Int?     // 1-5 accuracy rating
  clarity     Int?     // 1-5 clarity rating
  relevance   Int?     // 1-5 relevance rating

  content     String   @db.Text

  // Relations
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User     @relation("ArticlePeerReviews", fields: [userId], references: [id], onDelete: Cascade)
  parent      ArticlePeerReview?  @relation("PeerReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ArticlePeerReview[] @relation("PeerReviewReplies")
  likes       ReviewLike[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

// Review Likes - Track who liked which review/reply
model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String

  review    ArticlePeerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User              @relation("ReviewLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId]) // One like per user per review
  @@index([reviewId])
  @@index([userId])
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

// Track which users have read which articles
model ArticleRead {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

enum ModuleType {
  SMALL   // Quick facts, mark as read
  LARGE   // Tabs + quiz with perfect score requirement
}

// Learning Level - 6 educational levels
enum LearningLevel {
  ELEMENTARY      // Ages 6-10
  MIDDLE_SCHOOL   // Ages 11-13
  HIGH_SCHOOL     // Ages 14-17
  UNDERGRADUATE   // Ages 18-22
  GRADUATE        // Ages 22+
  PHD             // Expert level
}

// Activity Type for interactive learning
enum ActivityType {
  DRAG_DROP
  SIMULATION
  PUZZLE
  SCENARIO
  STEP_GUIDED
  TIMED_CHALLENGE
}

// Level-specific content for each learning module
model ModuleLevelContent {
  id                String         @id @default(cuid())
  articleId         String
  level             LearningLevel

  // Content
  introduction      String         @db.Text
  sections          Json           // Array of {id, title, content, interactiveElements}
  summary           String         @db.Text
  objectives        Json           // Array of learning objectives
  keyTerms          Json           // Array of {term, definition}

  // Interactive activities configuration
  activities        Json           // Array of ActivityConfig

  // Learning game configuration (replaces quiz)
  learningGame      Json           // LearningGameConfig

  // Metadata
  estimatedMinutes  Int
  readingLevel      String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  article           Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, level])
  @@index([articleId])
  @@index([level])
}

// Module discussion threads (tied to learning level)
model ModuleDiscussion {
  id                String         @id @default(cuid())
  articleId         String
  level             LearningLevel
  authorId          String

  title             String
  content           String         @db.Text

  isResolved        Boolean        @default(false)
  isPinned          Boolean        @default(false)
  viewCount         Int            @default(0)
  replyCount        Int            @default(0)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  article           Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author            User           @relation("ModuleDiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies           ModuleDiscussionReply[]

  @@index([articleId, level])
  @@index([authorId])
  @@index([createdAt])
}

// Replies to module discussions
model ModuleDiscussionReply {
  id                String         @id @default(cuid())
  discussionId      String
  authorId          String
  parentReplyId     String?        // For nested replies

  content           String         @db.Text
  isFromCompleter   Boolean        @default(false) // Author completed the module
  isAcceptedAnswer  Boolean        @default(false) // Marked as accepted by OP
  helpfulCount      Int            @default(0)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  discussion        ModuleDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author            User           @relation("ModuleDiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentReply       ModuleDiscussionReply? @relation("ReplyThread", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies      ModuleDiscussionReply[] @relation("ReplyThread")
  helpfulVotes      DiscussionHelpfulVote[]

  @@index([discussionId])
  @@index([authorId])
  @@index([parentReplyId])
}

// Helpful votes on discussion replies
model DiscussionHelpfulVote {
  id        String   @id @default(cuid())
  replyId   String
  voterId   String
  createdAt DateTime @default(now())

  reply     ModuleDiscussionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  voter     User     @relation("DiscussionHelpfulVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([replyId, voterId])
  @@index([replyId])
  @@index([voterId])
}

// Activity completion tracking
model ActivityProgress {
  id                String         @id @default(cuid())
  progressId        String         // Links to UserLearningProgress
  activityId        String

  completed         Boolean        @default(false)
  score             Int?           // Points earned
  attempts          Int            @default(0)
  bestScore         Int?
  timeSpent         Int?           // seconds

  submissionData    Json?          // User's submission details

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  progress          UserLearningProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, activityId])
  @@index([progressId])
}

// Learning game session tracking
model GameSession {
  id                String         @id @default(cuid())
  progressId        String

  // Game state
  currentRound      Int            @default(0)
  totalRounds       Int            @default(10)
  lives             Int            @default(3)
  maxLives          Int            @default(3)
  score             Int            @default(0)
  streak            Int            @default(0)
  maxStreak         Int            @default(0)

  // Results
  completed         Boolean        @default(false)
  passed            Boolean        @default(false)
  finalScore        Int?
  starsEarned       Int?           // 1-3 stars
  timeTaken         Int?           // seconds

  // Answer history
  answers           Json?          // Array of round results

  startedAt         DateTime       @default(now())
  completedAt       DateTime?

  progress          UserLearningProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId])
  @@index([completed])
}

// Learning Progress Tracking (Updated with level support)
model UserLearningProgress {
  id                String         @id @default(cuid())
  userId            String
  articleId         String

  // Learning level selection
  selectedLevel     LearningLevel  @default(HIGH_SCHOOL)

  // Progress tracking
  status            LearningStatus @default(IN_PROGRESS)
  progressPercentage Int           @default(0)  // 0-100 for large modules
  currentTabIndex   Int            @default(0)  // Current tab user is on (for large modules)
  currentSectionId  String?        // Current section ID

  // Quiz tracking (legacy - for backwards compatibility)
  quizAttempts      Int            @default(0)
  quizScore         Int?           // Last quiz score (0-5)
  quizPassed        Boolean        @default(false) // Must achieve perfect score (5/5)

  // Game tracking (new system)
  gameHighScore     Int?           // Highest game score achieved
  gameStars         Int?           // Best star rating (1-3)
  gamePassed        Boolean        @default(false)

  // Timestamps
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
  lastAccessedAt    DateTime       @updatedAt

  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  article           Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  activityProgress  ActivityProgress[]
  gameSessions      GameSession[]

  @@unique([userId, articleId, selectedLevel])
  @@index([userId])
  @@index([articleId])
  @@index([status])
  @@index([selectedLevel])
}

enum LearningStatus {
  IN_PROGRESS
  COMPLETED
}

// ============================================
// SOCIAL & GAMIFICATION MODELS
// ============================================

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// LinkedIn-style Connection model (mutual professional connections)
model Connection {
  id              String            @id @default(cuid())
  userId          String            // User who sent the request
  connectedUserId String            // User who received the request
  status          ConnectionStatus  @default(PENDING)
  message         String?           @db.Text // Optional message with connection request
  createdAt       DateTime          @default(now())
  acceptedAt      DateTime?         // When connection was accepted
  updatedAt       DateTime          @updatedAt

  user            User              @relation("SentConnections", fields: [userId], references: [id], onDelete: Cascade)
  connectedUser   User              @relation("ReceivedConnections", fields: [connectedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, connectedUserId])
  @@index([userId])
  @@index([connectedUserId])
  @@index([status])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// LinkedIn-style Skill Endorsement model
model Endorsement {
  id          String   @id @default(cuid())
  userId      String   // User being endorsed
  endorserId  String   // User giving the endorsement
  skill       String   // Skill being endorsed
  createdAt   DateTime @default(now())

  @@unique([userId, endorserId, skill])
  @@index([userId])
  @@index([endorserId])
  @@index([skill])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String      @db.Text
  icon        String
  criteria    Json        // Flexible criteria definition
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())

  @@index([slug])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ============================================
// SOCIAL FEED MODELS (Instagram/Meta-style)
// ============================================

model SocialPost {
  id          String          @id @default(cuid())
  content     String          @db.Text
  userId      String
  visibility  PostVisibility  @default(PUBLIC)
  user        User            @relation("SocialPosts", fields: [userId], references: [id], onDelete: Cascade)
  media       SocialMedia[]
  comments    SocialComment[]
  likes       SocialLike[]
  hashtags    String[]        // Array of hashtags
  mentions    String[]        // Array of mentioned user IDs
  shares      Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([visibility])
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

model SocialMedia {
  id        String    @id @default(cuid())
  postId    String
  type      MediaType
  url       String
  caption   String?
  order     Int       @default(0)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([postId])
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
}

model SocialComment {
  id        String          @id @default(cuid())
  content   String          @db.Text
  postId    String
  userId    String
  parentId  String?         // For nested comments
  post      SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User            @relation("SocialComments", fields: [userId], references: [id], onDelete: Cascade)
  parent    SocialComment?  @relation("CommentThread", fields: [parentId], references: [id])
  children  SocialComment[] @relation("CommentThread")
  likes     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model SocialLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation("SocialLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ============================================
// PROJECT COLLABORATION MODELS (Enhanced)
// Full-featured project system with Sage AI assistance
// ============================================

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String          @db.Text
  goal        String?         @db.Text
  status      ProjectStatus   @default(ACTIVE)
  visibility  ProjectVisibility @default(PUBLIC)
  coverImage  String?

  // Customizable layout configuration (JSON)
  layoutConfig Json?          @default("{}")

  // Creator/Owner
  creatorId   String
  creator     User            @relation("ProjectCreator", fields: [creatorId], references: [id])

  // Relations
  members             ProjectMember[]
  messages            ProjectMessage[]
  subgroups           ProjectSubgroup[]
  discussions         ProjectDiscussion[]
  researchPosts       ProjectResearch[]
  learningModules     ProjectLearningModule[]
  prerequisites       ProjectPrerequisite[]
  waivers             ProjectPrerequisiteWaiver[]
  contributions       ProjectContribution[]
  projectNotifications ProjectNotification[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([creatorId])
  @@index([status])
  @@index([visibility])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectVisibility {
  PUBLIC      // Everyone can view
  UNLISTED    // Only with direct link
}

model ProjectMember {
  id        String              @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole   @default(VIEWER)

  // Personalization - member's custom view arrangement
  layoutPreferences Json?       @default("{}")

  // Opt-in notifications
  notifyDiscussions Boolean     @default(false)
  notifyResearch    Boolean     @default(false)
  notifyUpdates     Boolean     @default(false)
  notifyMentions    Boolean     @default(true)

  // Contribution tracking
  contributionScore Int         @default(0)

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Recognition badges
  recognitions ProjectMemberRecognition[]

  joinedAt  DateTime            @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([role])
}

enum ProjectMemberRole {
  VIEWER        // Can view, pending approval or prerequisites not met
  CONTRIBUTOR   // Can contribute to project
  MODERATOR     // Can moderate discussions, approve content
  ADMIN         // Full admin rights (layout, members, settings)
  OWNER         // Project creator - cannot be removed
}

// Legacy ProjectRole kept for backwards compatibility
enum ProjectRole {
  MEMBER
  MODERATOR
  ADMIN
}

model ProjectMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectMessages", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// PROJECT SUBGROUPS
// Teams/working groups within projects
// ============================================

model ProjectSubgroup {
  id                String              @id @default(cuid())
  projectId         String
  name              String
  description       String?             @db.Text
  goal              String?             @db.Text
  isPrivate         Boolean             @default(false)

  // Subgroup-specific learning requirements
  requiresLearning  Boolean             @default(false)
  requiredModuleIds String[]            @default([])

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leaders           SubgroupLeader[]
  members           SubgroupMember[]
  discussions       SubgroupDiscussion[]
  joinRequests      SubgroupJoinRequest[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId])
  @@index([isPrivate])
}

model SubgroupLeader {
  id          String          @id @default(cuid())
  subgroupId  String
  userId      String
  subgroup    ProjectSubgroup @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  user        User            @relation("SubgroupLeaders", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime        @default(now())

  @@unique([subgroupId, userId])
  @@index([subgroupId])
  @@index([userId])
}

model SubgroupMember {
  id            String          @id @default(cuid())
  subgroupId    String
  userId        String
  canContribute Boolean         @default(true)  // false = learning/viewing only
  subgroup      ProjectSubgroup @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  user          User            @relation("SubgroupMembers", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime        @default(now())

  @@unique([subgroupId, userId])
  @@index([subgroupId])
  @@index([userId])
}

model SubgroupJoinRequest {
  id          String              @id @default(cuid())
  subgroupId  String
  userId      String
  status      JoinRequestStatus   @default(PENDING)
  message     String?             @db.Text
  subgroup    ProjectSubgroup     @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  user        User                @relation("SubgroupJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  @@unique([subgroupId, userId])
  @@index([subgroupId])
  @@index([userId])
  @@index([status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// ============================================
// PROJECT DISCUSSIONS
// Forum-style discussions within projects
// ============================================

model ProjectDiscussion {
  id          String              @id @default(cuid())
  projectId   String
  title       String
  content     String              @db.Text
  isPinned    Boolean             @default(false)
  isLocked    Boolean             @default(false)
  viewCount   Int                 @default(0)
  authorId    String

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                @relation("ProjectDiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies     ProjectDiscussionReply[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([projectId])
  @@index([authorId])
  @@index([isPinned])
  @@index([createdAt])
}

model ProjectDiscussionReply {
  id            String              @id @default(cuid())
  discussionId  String
  content       String              @db.Text
  authorId      String
  parentId      String?             // For nested replies

  discussion    ProjectDiscussion   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author        User                @relation("ProjectDiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent        ProjectDiscussionReply?  @relation("DiscussionReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  children      ProjectDiscussionReply[] @relation("DiscussionReplyThread")

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([discussionId])
  @@index([authorId])
  @@index([parentId])
}

// Subgroup-specific discussions
model SubgroupDiscussion {
  id          String              @id @default(cuid())
  subgroupId  String
  title       String
  content     String              @db.Text
  isPinned    Boolean             @default(false)
  authorId    String

  subgroup    ProjectSubgroup     @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  author      User                @relation("SubgroupDiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies     SubgroupDiscussionReply[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([subgroupId])
  @@index([authorId])
}

model SubgroupDiscussionReply {
  id            String              @id @default(cuid())
  discussionId  String
  content       String              @db.Text
  authorId      String

  discussion    SubgroupDiscussion  @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author        User                @relation("SubgroupDiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([discussionId])
  @@index([authorId])
}

// ============================================
// PROJECT RESEARCH (Article-style posts)
// News article format with heading, summary, source
// ============================================

model ProjectResearch {
  id          String              @id @default(cuid())
  projectId   String

  // Article-style structure
  heading     String
  summary     String              @db.Text
  fullContent String?             @db.Text
  sourceUrl   String?
  sourceTitle String?

  // Metadata
  authorId    String
  tags        String[]            @default([])
  isPinned    Boolean             @default(false)
  viewCount   Int                 @default(0)

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                @relation("ProjectResearchAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments    ProjectResearchComment[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([projectId])
  @@index([authorId])
  @@index([isPinned])
  @@index([createdAt])
}

model ProjectResearchComment {
  id          String            @id @default(cuid())
  researchId  String
  content     String            @db.Text
  authorId    String

  research    ProjectResearch   @relation(fields: [researchId], references: [id], onDelete: Cascade)
  author      User              @relation("ProjectResearchCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([researchId])
  @@index([authorId])
}

// ============================================
// PROJECT LEARNING MODULES
// Built-in courses from basic to current state
// ============================================

model ProjectLearningModule {
  id          String                  @id @default(cuid())
  projectId   String

  title       String
  description String?                 @db.Text
  order       Int                     @default(0)

  // Content
  videoUrl    String?
  textContent String?                 @db.Text

  // Accreditation
  isAccredited Boolean                @default(false)
  difficulty  ProjectModuleDifficulty @default(BEGINNER)
  estimatedMinutes Int?

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progress    ProjectModuleProgress[]

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([projectId])
  @@index([order])
  @@index([difficulty])
}

enum ProjectModuleDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  CURRENT_STATE  // Catches up to where project is now
}

model ProjectModuleProgress {
  id          String                      @id @default(cuid())
  moduleId    String
  userId      String
  status      ProjectModuleProgressStatus @default(NOT_STARTED)
  progress    Int                         @default(0)  // 0-100

  module      ProjectLearningModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User                        @relation("ProjectModuleProgress", fields: [userId], references: [id], onDelete: Cascade)

  startedAt   DateTime?
  completedAt DateTime?

  @@unique([moduleId, userId])
  @@index([moduleId])
  @@index([userId])
  @@index([status])
}

enum ProjectModuleProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ============================================
// EXODOLOGY LEARNING PROGRESS
// Tracks user progress through Exodology curriculum
// ============================================

model ExodologyProgress {
  id              String                    @id @default(cuid())
  userId          String

  // Path tracking (foundations, applied, strategic)
  pathId          String

  // Lesson tracking
  lessonId        String
  status          ExodologyLessonStatus     @default(NOT_STARTED)

  // Game/exercise completion data (JSON for flexibility)
  completionData  Json?                     // Stores mastered cards, matched pairs, etc.

  // Timestamps
  startedAt       DateTime?
  completedAt     DateTime?
  lastAccessedAt  DateTime                  @default(now())

  user            User                      @relation("ExodologyProgress", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId, lessonId])
  @@index([userId])
  @@index([pathId])
  @@index([lessonId])
  @@index([status])
}

enum ExodologyLessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model ExodologyCertification {
  id              String                    @id @default(cuid())
  userId          String

  // Which certification (foundations, applied, strategic, or master)
  certificationId String
  pathId          String?                   // null for master certification

  // Certificate details
  issuedAt        DateTime                  @default(now())
  certificateNumber String                  @unique @default(cuid())

  user            User                      @relation("ExodologyCertifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, certificationId])
  @@index([userId])
  @@index([certificationId])
}

// User's learning streak tracking
model ExodologyStreak {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  currentStreak   Int                       @default(0)
  longestStreak   Int                       @default(0)
  lastActivityDate DateTime?
  streakStartDate DateTime?
  totalLearningDays Int                     @default(0)

  user            User                      @relation("ExodologyStreak", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User's notes on lessons
model ExodologyNote {
  id              String                    @id @default(cuid())
  userId          String
  pathId          String
  lessonId        String
  content         String                    @db.Text
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user            User                      @relation("ExodologyNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// Spaced repetition review schedule
model ExodologyReview {
  id              String                    @id @default(cuid())
  userId          String
  pathId          String
  lessonId        String
  nextReviewDate  DateTime
  interval        Int                       @default(1)  // days until next review
  easeFactor      Float                     @default(2.5) // SM-2 algorithm factor
  reviewCount     Int                       @default(0)
  lastReviewDate  DateTime?

  user            User                      @relation("ExodologyReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId, lessonId])
  @@index([userId])
  @@index([nextReviewDate])
}

// ============================================
// PROJECT PREREQUISITES
// Course requirements for contribution access
// ============================================

model ProjectPrerequisite {
  id                  String              @id @default(cuid())
  projectId           String

  // Type of prerequisite
  type                PrerequisiteType

  // For EXODUS_COURSE type - reference to Exodus Academy article/module
  exodusCourseId      String?

  // For PROJECT_MODULE type - reference to project's own learning module
  projectModuleId     String?

  // For TAG_MATCH type - courses matching this tag
  requiredTag         String?

  // For STOCK_LEVEL type - minimum STOCK score
  minStockScore       Int?

  // Description for display
  displayName         String?
  description         String?             @db.Text

  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt           DateTime            @default(now())

  @@index([projectId])
  @@index([type])
}

enum PrerequisiteType {
  EXODUS_COURSE       // Specific Exodus Academy course
  PROJECT_MODULE      // Project's own learning module
  TAG_MATCH           // Courses matching a tag
  STOCK_LEVEL         // Minimum STOCK score
}

// ============================================
// PREREQUISITE WAIVERS
// Admin-granted exceptions with AI assistance
// ============================================

model ProjectPrerequisiteWaiver {
  id          String              @id @default(cuid())
  projectId   String
  userId      String

  // Who approved
  approvedById String
  aiAssisted  Boolean             @default(false)
  aiConfidence Int?               // 0-100 confidence score from Sage
  reason      String?             @db.Text

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                @relation("ProjectWaivers", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User                @relation("ProjectWaiversApproved", fields: [approvedById], references: [id], onDelete: Cascade)

  createdAt   DateTime            @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ============================================
// MEMBER RECOGNITION (Badges)
// Non-star ranking system
// ============================================

model ProjectMemberRecognition {
  id          String              @id @default(cuid())
  memberId    String              // ProjectMember ID
  badge       ProjectRecognitionBadge

  member      ProjectMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  earnedAt    DateTime            @default(now())

  @@unique([memberId, badge])
  @@index([memberId])
  @@index([badge])
}

enum ProjectRecognitionBadge {
  PIONEER           // Early contributor to the project
  ARCHITECT         // Significant structural contributions
  SCHOLAR           // Completed all learning + contributing
  MENTOR            // Helping others learn
  RESEARCHER        // Active in research sections
  PATHFINDER        // Finding and sharing new resources
  STEWARD           // Long-term consistent contributor
  CATALYST          // Sparking productive discussions
  RISING_STAR       // Learning the process, showing growth
  TOP_CONTRIBUTOR   // Highest contribution score
}

// ============================================
// CONTRIBUTION TRACKING
// Track all project contributions for STOCK
// ============================================

model ProjectContribution {
  id          String              @id @default(cuid())
  projectId   String
  userId      String

  type        ProjectContributionType
  referenceId String?             // ID of the thing contributed
  points      Int                 @default(1)

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                @relation("ProjectContributions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime            @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum ProjectContributionType {
  DISCUSSION_STARTED
  DISCUSSION_REPLY
  RESEARCH_POSTED
  RESEARCH_COMMENT
  MODULE_CREATED
  MODULE_COMPLETED
  SUBGROUP_CREATED
  MEMBER_MENTORED
  RESOURCE_SHARED
}

// ============================================
// PROJECT NOTIFICATIONS (Opt-in)
// Granular notification system
// ============================================

model ProjectNotification {
  id          String                      @id @default(cuid())
  projectId   String
  userId      String

  type        ProjectNotificationType
  title       String
  content     String?
  referenceId String?
  isRead      Boolean                     @default(false)

  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                        @relation("ProjectNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime                    @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum ProjectNotificationType {
  DISCUSSION_REPLY
  DISCUSSION_MENTION
  RESEARCH_UPDATE
  RESEARCH_COMMENT
  SUBGROUP_UPDATE
  SUBGROUP_INVITE
  ROLE_CHANGE
  BADGE_EARNED
  WAIVER_APPROVED
  WAIVER_DENIED
  PROJECT_ANNOUNCEMENT
}

// ============================================
// DIRECT MESSAGING MODELS
// ============================================

model DirectMessage {
  id           String   @id @default(cuid())
  content      String   @db.Text
  senderId     String
  receiverId   String
  read         Boolean  @default(false)
  editedAt     DateTime?
  deletedAt    DateTime?
  sender       User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]
  createdAt    DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([read])
}

model MessageReaction {
  id        String        @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// ============================================
// EVENTS & MEETUPS MODELS
// ============================================

model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  type        EventType     @default(VIRTUAL)
  location    String?       // For in-person events
  meetingLink String?       // For virtual events
  startDate   DateTime
  endDate     DateTime?
  maxCapacity Int?
  coverImage  String?
  creatorId   String
  creator     User          @relation("CreatedEvents", fields: [creatorId], references: [id])
  attendees   EventAttendee[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([creatorId])
  @@index([startDate])
  @@index([type])
}

enum EventType {
  VIRTUAL
  IN_PERSON
  HYBRID
}

model EventAttendee {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  status    AttendeeStatus   @default(GOING)
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime         @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

enum AttendeeStatus {
  GOING
  MAYBE
  NOT_GOING
}

// ============================================
// NOTIFICATION & MODERATION MODELS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  PRODUCT_APPROVED
  ARTICLE_PUBLISHED
  COMMENT_REPLY
  FORUM_REPLY
  NEW_FOLLOWER
  BADGE_EARNED
  PROJECT_INVITE
  NEW_MESSAGE
  SYSTEM
}

model Report {
  id             String         @id @default(cuid())
  reason         String         @db.Text
  status         ReportStatus   @default(PENDING)
  priority       ReportPriority @default(MEDIUM)
  contentType    String         // 'user', 'product', 'article', 'comment', 'post'
  contentId      String
  reporterId     String
  reporter       User           @relation("ReportedBy", fields: [reporterId], references: [id])
  assignedToId   String?
  assignedTo     User?          @relation("ReportAssignedTo", fields: [assignedToId], references: [id])
  resolvedById   String?
  resolvedBy     User?          @relation("ReportResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?        @db.Text

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?

  @@index([reporterId])
  @@index([status])
  @@index([contentType])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdAt])
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model AdminLog {
  id          String         @id @default(cuid())
  action      AdminAction
  description String         @db.Text
  metadata    Json?
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum AdminAction {
  USER_BANNED
  USER_UNBANNED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  ARTICLE_PUBLISHED
  ARTICLE_UNPUBLISHED
  CONTENT_DELETED
  REPORT_RESOLVED
  SETTINGS_CHANGED
  OTHER
}

// ============================================
// USER MARKETPLACE MODELS
// ============================================

model UserProduct {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  price           Float
  category        String
  materials       String   // Sustainable materials used
  images          String[] // Array of image URLs
  externalUrl     String   // Link to user's store (Etsy, Shopify, etc.)

  // Approval workflow
  approvalStatus  ProductApprovalStatus @default(PENDING)
  rejectionReason String?  @db.Text
  affiliateLink   String?  // Project Exodus affiliate link (generated after approval)
  reviewedBy      String?  // Admin who reviewed
  reviewedAt      DateTime?

  // Seller info
  sellerId        String
  seller          User     @relation("UserProducts", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sellerId])
  @@index([approvalStatus])
  @@index([category])
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// SYSTEM & SETTINGS MODELS
// ============================================

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  html      String   @db.Text
  text      String?  @db.Text
  variables Json?    // Available variables
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  status      SubscriptionStatus @default(ACTIVE)
  source      String?  // Where they subscribed from
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

// ============================================
// ADMIN & RBAC MODELS
// ============================================

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

model AdminAlert {
  id        String            @id @default(cuid())
  type      AdminAlertType
  priority  AlertPriority     @default(MEDIUM)
  title     String
  message   String            @db.Text
  link      String?
  read      Boolean           @default(false)
  userId    String?           // Target admin (null = all admins)
  user      User?             @relation("AdminAlerts", fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?             // Additional context data
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([read])
  @@index([priority])
  @@index([type])
  @@index([createdAt])
}

enum AdminAlertType {
  NEW_REPORT
  USER_BANNED
  SECURITY_ALERT
  SYSTEM_ERROR
  CONTENT_FLAGGED
  PRODUCT_SUBMISSION
  HIGH_PRIORITY_REPORT
  ADMIN_ACTION
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model UserBan {
  id          String    @id @default(cuid())
  userId      String
  bannedById  String
  reason      String    @db.Text
  expiresAt   DateTime? // Null = permanent
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  unbannedAt  DateTime?
  unbannedById String?

  @@index([userId])
  @@index([active])
  @@index([expiresAt])
}

// ============================================
// ARTICLE READING EXPERIENCE
// Progress tracking, bookmarks, highlights
// ============================================

model ArticleReadingProgress {
  id             String    @id @default(cuid())
  userId         String
  articleId      String
  scrollProgress Float     @default(0)    // 0-100 percentage
  timeSpent      Int       @default(0)    // seconds spent reading
  lastPosition   Int?                      // paragraph/section index
  completed      Boolean   @default(false)
  completedAt    DateTime?
  user           User      @relation("ArticleReadingProgress", fields: [userId], references: [id], onDelete: Cascade)
  article        Article   @relation("ArticleReadingProgress", fields: [articleId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([completed])
}

model ArticleBookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  position  Int                           // Paragraph or section index
  title     String?                       // Optional bookmark title
  note      String?  @db.Text            // Optional note
  user      User     @relation("ArticleBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation("ArticleBookmarks", fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([articleId])
}

model ArticleHighlight {
  id         String   @id @default(cuid())
  userId     String
  articleId  String
  startPos   Int                          // Start character position
  endPos     Int                          // End character position
  text       String   @db.Text           // The highlighted text
  color      String   @default("yellow") // yellow, green, blue, pink, purple
  note       String?  @db.Text           // Optional annotation
  user       User     @relation("ArticleHighlights", fields: [userId], references: [id], onDelete: Cascade)
  article    Article  @relation("ArticleHighlights", fields: [articleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([articleId])
}

// ============================================
// READING COLLECTIONS & LISTS
// Curated article collections and reading lists
// ============================================

model ReadingCollection {
  id          String              @id @default(cuid())
  userId      String
  name        String
  slug        String              @unique
  description String?             @db.Text
  coverImage  String?
  isPublic    Boolean             @default(false)
  isFeatured  Boolean             @default(false)
  user        User                @relation("ReadingCollections", fields: [userId], references: [id], onDelete: Cascade)
  articles    CollectionArticle[]
  followers   CollectionFollow[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@index([isFeatured])
  @@index([slug])
}

model CollectionArticle {
  id           String            @id @default(cuid())
  collectionId String
  articleId    String
  order        Int               @default(0)
  note         String?           @db.Text // Curator's note for this article
  collection   ReadingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  article      Article           @relation("CollectionArticles", fields: [articleId], references: [id], onDelete: Cascade)
  addedAt      DateTime          @default(now())

  @@unique([collectionId, articleId])
  @@index([collectionId])
  @@index([articleId])
}

model CollectionFollow {
  id           String            @id @default(cuid())
  userId       String
  collectionId String
  user         User              @relation("CollectionFollows", fields: [userId], references: [id], onDelete: Cascade)
  collection   ReadingCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([userId, collectionId])
  @@index([userId])
  @@index([collectionId])
}

// ============================================
// GAMIFICATION SYSTEM
// Achievements, streaks, points, leaderboards
// ============================================

model Achievement {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  description      String
  icon             String                            // Emoji or icon name
  category         AchievementCategory
  points           Int                 @default(10)
  requirement      Json                              // {type: 'articles_read', count: 10}
  rarity           AchievementRarity   @default(COMMON)
  secret           Boolean             @default(false) // Hidden until earned
  userAchievements UserAchievement[]
  createdAt        DateTime            @default(now())

  @@index([category])
  @@index([rarity])
}

enum AchievementCategory {
  READING       // Reading milestones
  CONTRIBUTION  // Writing, reviewing
  ENGAGEMENT    // Comments, likes, discussions
  STREAK        // Consistency streaks
  EXPLORATION   // Categories, topics explored
  SOCIAL        // Following, sharing, connecting
  MASTERY       // Deep expertise in areas
}

enum AchievementRarity {
  COMMON      // Easy to get
  UNCOMMON    // Some effort required
  RARE        // Significant achievement
  EPIC        // Major accomplishment
  LEGENDARY   // Exceptional dedication
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  progress      Int         @default(0)           // Progress toward requirement
  completed     Boolean     @default(false)
  completedAt   DateTime?
  notified      Boolean     @default(false)       // Has user seen the notification
  user          User        @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([completed])
}

model ReadingStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastReadDate    DateTime?
  totalDaysRead   Int       @default(0)
  weekStartStreak Int       @default(0)          // Streak at start of week
  freezesUsed     Int       @default(0)          // Streak freezes used this month
  freezesAvailable Int      @default(2)          // Streak freezes available
  user            User      @relation("ReadingStreak", fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([currentStreak])
  @@index([longestStreak])
}

model UserPoints {
  id            String             @id @default(cuid())
  userId        String             @unique
  totalPoints   Int                @default(0)
  weeklyPoints  Int                @default(0)
  monthlyPoints Int                @default(0)
  allTimePoints Int                @default(0)
  level         Int                @default(1)
  levelProgress Int                @default(0)    // Progress to next level (0-100)
  user          User               @relation("UserPoints", fields: [userId], references: [id], onDelete: Cascade)
  transactions  PointTransaction[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([totalPoints])
  @@index([level])
}

model PointTransaction {
  id           String     @id @default(cuid())
  userPointsId String
  amount       Int                              // Can be negative for deductions
  reason       PointReason
  description  String?                          // Human-readable description
  referenceId  String?                          // Related article, review, etc.
  referenceType String?                         // 'article', 'review', 'achievement', etc.
  userPoints   UserPoints @relation(fields: [userPointsId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([userPointsId])
  @@index([reason])
  @@index([createdAt])
}

enum PointReason {
  ARTICLE_READ
  ARTICLE_COMPLETED
  REVIEW_WRITTEN
  REVIEW_HELPFUL         // Review received likes
  COMMENT_POSTED
  ACHIEVEMENT_EARNED
  STREAK_BONUS
  DAILY_LOGIN
  FIRST_OF_DAY          // First article of the day bonus
  COLLECTION_CREATED
  ARTICLE_PUBLISHED
  REFERRAL_BONUS
}

// ============================================
// AUTHOR ANALYTICS
// Cached analytics for author dashboards
// ============================================

model AuthorAnalytics {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalArticles      Int      @default(0)
  totalViews         Int      @default(0)
  totalReads         Int      @default(0)     // Completed reads
  totalTimeSpent     Int      @default(0)     // Total seconds readers spent
  avgReadCompletion  Float?                   // Average completion percentage
  avgRating          Float?                   // Average peer review rating
  totalReviews       Int      @default(0)
  totalComments      Int      @default(0)
  followerCount      Int      @default(0)
  // Time-based metrics
  viewsToday         Int      @default(0)
  viewsThisWeek      Int      @default(0)
  viewsThisMonth     Int      @default(0)
  readsToday         Int      @default(0)
  readsThisWeek      Int      @default(0)
  readsThisMonth     Int      @default(0)
  // Category performance
  topCategories      Json?                    // [{categoryId, categoryName, articleCount, views}]
  topArticles        Json?                    // [{articleId, title, views, rating}]
  // Engagement trends
  engagementTrend    Json?                    // [{date, views, reads, reviews}]
  user               User     @relation("AuthorAnalytics", fields: [userId], references: [id], onDelete: Cascade)
  updatedAt          DateTime @updatedAt
}

// ============================================
// ARTICLE RECOMMENDATIONS
// For personalized content discovery
// ============================================

model ArticleRecommendation {
  id          String   @id @default(cuid())
  userId      String
  articleId   String
  score       Float                          // Recommendation score (0-1)
  reason      String                         // 'similar_content', 'popular_in_category', 'followed_author', etc.
  seen        Boolean  @default(false)
  clicked     Boolean  @default(false)
  dismissed   Boolean  @default(false)
  user        User     @relation("ArticleRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  article     Article  @relation("ArticleRecommendations", fields: [articleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime                       // Recommendations expire after some time

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([score])
  @@index([expiresAt])
}
