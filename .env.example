# Database
DATABASE_URL="postgresql://user:password@host.region.neon.tech/database?sslmode=require"

# NextAuth v5 (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-here"
# Development:
NEXTAUTH_URL="http://localhost:3000"
# Production (set in Vercel dashboard):
# NEXTAUTH_URL="https://projxodus.com"

# App
# Development:
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Production (set in Vercel dashboard):
# NEXT_PUBLIC_API_URL="https://projxodus.com"

# OAuth Providers (optional - app will work with just email/password if not set)
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Facebook OAuth: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Apple Sign In: https://developer.apple.com/account/resources/
# Requires Apple Developer Program ($99/year)
APPLE_ID="your-apple-service-id"
APPLE_SECRET="your-apple-secret-key"

# Cloudinary (for image + article content cloud storage)
# Get free credentials at: https://cloudinary.com
# Used for cover images AND offloading article content from the database
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Pusher (for real-time messaging)
# Get free credentials at: https://pusher.com
PUSHER_APP_ID="your-app-id"
PUSHER_SECRET="your-secret"
NEXT_PUBLIC_PUSHER_KEY="your-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# PartyKit (for real-time collaborative document editing)
# Deploy with: npm run party:deploy
# Development: runs on 127.0.0.1:1999 (npm run party:dev)
# Production: exodus-collab.YOUR_USERNAME.partykit.dev
# NEXT_PUBLIC_PARTYKIT_HOST="exodus-collab.your-username.partykit.dev"
